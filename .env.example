# drizzle-kit が D1 HTTP API 経由でマイグレーションを発行するための資格情報
# Cloudflare ダッシュボード → Workers & Pages → Overview から取得
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLOUDFLARE_D1_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === E2E (Mailosaur) — テスト基盤専用。Worker ランタイムには渡らない ===
# Playwright (global-setup / spec) と メールリレー (scripts/mail-relay.mjs) が参照する。
# E2E を実行しない場合は空でよい (op inject を通すため 1Password の field 自体は作成する)。
# API Key / Server ID は Mailosaur dashboard → Server から取得。
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=
# Mailosaur SMTP (リレーがここへ転送する。全宛先を捕捉するので送信ドメイン onboard 不要)。
# 必須は PASS のみ。受信箱の "Connect" タブに表示される SMTP password を入れる。
# HOST / PORT / USER は省略可 (リレーが既定値を使う):
#   HOST 既定 smtp.mailosaur.net / PORT 既定 2525 (STARTTLS) /
#   USER は <ServerID>@mailosaur.net を ServerID から自動導出
MAILOSAUR_SMTP_PASS=
MAILOSAUR_SMTP_HOST=
MAILOSAUR_SMTP_PORT=
MAILOSAUR_SMTP_USER=
