{
  "name": "vite-plus-cloudflare-hono-inertia-react",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm cf-typegen",
    "predev": "pnpm cf-typegen && pnpm db:migrate:local",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "pnpm cf-typegen && pnpm db:migrate:local && vp dev",
    "prebuild": "pnpm cf-typegen",
    "build": "vp build",
    "cf:build": "pnpm db:migrate:remote && pnpm build && pnpm build",
    "check": "vp check && knip --no-config-hints && depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip --no-config-hints",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest --project unit",
    "test:run": "vitest run --project unit",
    "deploy": "wrangler deploy --config dist/client/todo_app/wrangler.json",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply todo-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply todo-app-db --remote",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project storybook",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "chromatic": "chromatic",
    "chromatic:storybook": "chromatic --storybook-build-dir storybook-static",
    "chromatic:playwright": "chromatic --playwright",
    "audit:signatures": "npx --yes npm@latest audit signatures",
    "secrets:pull": "node scripts/secrets-pull.mjs",
    "secrets:pull:local": "node scripts/secrets-pull.mjs local",
    "secrets:pull:prod": "node scripts/secrets-pull.mjs prod",
    "secrets:pull:ci": "node scripts/secrets-pull.mjs local .dev.vars .env"
  },
  "dependencies": {
    "@hono/inertia": "0.7.0",
    "@hono/zod-validator": "0.9.0",
    "@inertiajs/react": "3.7.0",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "0.14.12",
    "@cloudflare/vite-plugin": "1.53.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "better-sqlite3": "12.10.0",
    "chromatic": "17.2.0",
    "daisyui": "5.7.21",
    "dependency-cruiser": "17.4.3",
    "drizzle-kit": "0.31.10",
    "knip": "6.32.2",
    "mailosaur": "11.1.1",
    "nodemailer": "9.0.5",
    "storybook": "10.5.10",
    "storybook-addon-vis": "4.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plus": "0.2.9",
    "vitest": "4.1.11",
    "wrangler": "4.125.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.1.3"
}
