{
  "name": "vite-plus-cloudflare-hono-inertia-react",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm cf-typegen",
    "predev": "pnpm cf-typegen && pnpm db:migrate:local",
    "dev": "vp dev",
    "prebuild": "pnpm cf-typegen",
    "build": "vp build",
    "cf:build": "pnpm db:migrate:remote && pnpm build",
    "check": "vp check",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy": "wrangler deploy --config dist/client/todo_app/wrangler.json",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply todo-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply todo-app-db --remote",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "audit:signatures": "npx --yes npm@latest audit signatures",
    "secrets:pull": "node scripts/secrets-pull.mjs",
    "secrets:pull:local": "node scripts/secrets-pull.mjs local",
    "secrets:pull:prod": "node scripts/secrets-pull.mjs prod",
    "secrets:pull:ci": "node scripts/secrets-pull.mjs local .dev.vars"
  },
  "dependencies": {
    "@hono/inertia": "0.2.0",
    "@hono/zod-validator": "0.8.0",
    "@inertiajs/react": "3.1.1",
    "better-auth": "1.6.11",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.19",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.2",
    "@playwright/test": "1.60.0",
    "@storybook/react-vite": "10.4.0",
    "@storybook/test-runner": "0.24.4",
    "@tailwindcss/vite": "4.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/jest-image-snapshot": "6.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "better-sqlite3": "12.10.0",
    "daisyui": "5.5.20",
    "drizzle-kit": "0.31.10",
    "jest-image-snapshot": "6.5.2",
    "storybook": "10.4.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vite-plus": "0.1.21",
    "vitest": "4.1.6",
    "wrangler": "4.93.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.1.3"
}
