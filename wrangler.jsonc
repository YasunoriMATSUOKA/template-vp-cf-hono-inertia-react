{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-app",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Assets でクライアントビルド成果物を配信
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
  // D1 (Drizzle 経由で利用)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-app-db",
      "database_id": "2ea7f372-8225-4b82-8e80-8bf91fd1a9d8",
      "migrations_dir": "migrations",
    },
  ],
  // R2 (デモではアバター等の置き場として用意。今回の todo では未使用)
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "todo-app-files",
    },
  ],
  // Cloudflare Rate Limiting (per-IP, /api/auth/sign-in & /api/auth/sign-up 用)。
  // Workers Rate Limiting API は dev runtime (miniflare/workerd) では noop に近い fallback
  // となるため、CI / local では制限は事実上掛からない。本番でのみ実値が効く。
  // namespace_id は account 内でユニーク (Cloudflare dashboard の生成済 ID と一致させる)。
  // simple.period は仕様上 10 または 60 のみ許容。
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  // Cloudflare Email Sending (認証メール: 確認 / リセット / メール変更)。
  // 本番でのみ実送信。送信ドメインを Email Routing で onboard (MX/SPF/DKIM) し、
  // 送信元 `env.EMAIL_FROM` をそのドメイン上のアドレスにすると任意宛先へ送れる。
  // local dev では send_email は実送信せず、E2E では Mailosaur へのローカルリレーに差し替える
  // (src/server/features/auth/email.ts 参照)。
  "send_email": [{ "name": "SEND_EMAIL" }],
  // APP_URL / EMAIL_FROM / MAIL_RELAY_URL は環境ごとに値が違うため `wrangler.jsonc` の
  // `vars` には置かない:
  //   - local / CI: `.dev.vars` (1Password から pull) で bind
  //   - prod: Cloudflare dashboard で Worker Secret / var として登録 (deploy 越しに保持)
  // `wrangler types` は `.dev.vars` も読んで `Env` interface に型を生やすので、
  // TypeScript からは `env.APP_URL: string` 等として参照できる。
  // MAIL_RELAY_URL は通常空 (= 本番/素のローカル dev では relay 無効)、E2E でのみ設定する。
  "observability": {
    "enabled": true,
  },
}
