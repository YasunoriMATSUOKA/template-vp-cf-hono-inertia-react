# Better Auth が `baseURL` として使うアプリの公開 URL。
# local dev は http://localhost:5173、prod は Cloudflare dashboard で Worker Secret として登録する想定。
APP_URL=http://localhost:5173

# Better Auth が署名・暗号化に使うシークレット。openssl rand -base64 32 などで生成
BETTER_AUTH_SECRET=replace-me-with-random-32-bytes

# Google Cloud Console → OAuth 2.0 クライアント ID から取得
# 承認済みリダイレクト URI に http://localhost:5173/api/auth/callback/google を追加
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 認証メール (確認 / リセット / メール変更) の送信元アドレス。
# 本番は Cloudflare Email Routing で onboard 済みドメイン上のアドレスにする。
# local dev では実送信しない (URL を console 出力) ため任意の値で可。
EMAIL_FROM=no-reply@example.com

# ローカル (dev / E2E) で認証メールを実送信するためのローカルリレー URL。
# `pnpm dev` / `pnpm e2e` はこれを使って Worker → リレー → Mailosaur SMTP に送る。
# 本番 (Cloudflare) では設定しない & email.ts の DEV ガードで relay 分岐は dead-code 化されるため、
# この値があっても本番送信には一切影響しない (本番は send_email binding を使う)。
MAIL_RELAY_URL=http://localhost:3001/send
